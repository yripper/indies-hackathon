# Postgres
DATABASE_URL=postgres://indies:indies@localhost:5432/indies

# LLM keys — only the one matching agent.config.yaml's provider needs to be set
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: override base URL to use an OpenAI-compatible endpoint
# (e.g. MiniMax: https://api.minimax.io/v1). Leave empty for OpenAI proper.
OPENAI_BASE_URL=

# Reality Defender (deepfake detection). Required only when
# analyze_audio_deepfake is enabled in agent.config.yaml.
# Free tier: 50 audio/image scans per month. Sign up at https://app.realitydefender.ai
REALITY_DEFENDER_API_KEY=

# Sightengine (second-opinion image detector). Free tier: 2000 ops/month.
# Sign up at https://sightengine.com (Dashboard → API credentials).
# When unset, image analysis uses Reality Defender only.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Baileys
WA_SESSION_KEY=
SESSIONS_DIR=./sessions

# Server
PORT=3000
HOST=0.0.0.0

# Agent config path
AGENT_CONFIG_PATH=./agent.config.yaml

# Node env
NODE_ENV=development

# Deepfake video detection service
# Local: http://localhost:7860  |  HF Spaces: https://<user>-deepfake-detector.hf.space
DEEPFAKE_SERVICE_URL=http://localhost:7860
