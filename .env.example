# Postgres
DATABASE_URL=postgres://indies:indies@localhost:5432/indies

# LLM keys — only the one matching agent.config.yaml's provider needs to be set
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: override base URL to use an OpenAI-compatible endpoint
# (e.g. MiniMax: https://api.minimax.io/v1). Leave empty for OpenAI proper.
OPENAI_BASE_URL=

# Baileys
WA_SESSION_KEY=
SESSIONS_DIR=./sessions

# Server
PORT=3000
HOST=0.0.0.0

# Agent config path
AGENT_CONFIG_PATH=./agent.config.yaml

# Reality Defender (image deepfake detection). Free tier: ~50 scans/month
# combined across audio + image. Sign up at https://realitydefender.com/.
REALITY_DEFENDER_API_KEY=

# Sightengine (second-opinion AI-generated image detector). Free tier:
# 2000 ops/month, 500/day, 1 req/s. Sign up at
# https://dashboard.sightengine.com/signup.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Node env
NODE_ENV=development
