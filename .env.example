# Postgres
DATABASE_URL=postgres://indies:indies@localhost:5432/indies

# LLM keys — only the one matching agent.config.yaml's provider needs to be set
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: override base URL to use an OpenAI-compatible endpoint
# (e.g. MiniMax: https://api.minimax.io/v1). Leave empty for OpenAI proper.
OPENAI_BASE_URL=

# Baileys
WA_SESSION_KEY=
SESSIONS_DIR=./sessions

# Server
PORT=3000
HOST=0.0.0.0

# Agent config path
AGENT_CONFIG_PATH=./agent.config.yaml

# Node env
NODE_ENV=development
